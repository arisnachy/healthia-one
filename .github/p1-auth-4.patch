diff --git a/web/styles.css b/web/styles.css
--- a/web/styles.css
+++ b/web/styles.css
@@ -752,3 +752,50 @@
 .execution-card footer { display: flex; justify-content: space-between; gap: 10px; margin-top: 10px; color: var(--muted); font-size: 8px; }
 @media (max-width: 900px) { .execution-trace { grid-template-columns: 1fr 1fr; } }
 @media (max-width: 560px) { .execution-trace { grid-template-columns: 1fr; } }
+
+/* Identity Platform login: one account, one patient scope. */
+.auth-gate { min-height: 100vh; display: grid; place-items: center; padding: 28px; background: #f8fafc; }
+.auth-gate[hidden] { display: none !important; }
+.auth-card { width: min(430px, 100%); background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 26px; box-shadow: 0 24px 70px rgba(33,51,78,.10); }
+.auth-brand { display: flex; gap: 11px; align-items: center; }
+.auth-mark { width: 42px; height: 42px; border-radius: 14px; display: grid; place-items: center; color: #fff; background: #344b70; font-size: 22px; }
+.auth-brand strong,.auth-brand span { display: block; }.auth-brand strong { font-size: 14px; }.auth-brand span { color: var(--muted); font-size: 10px; margin-top: 2px; }
+.auth-copy { margin: 25px 0 18px; }.auth-copy > span { font-size: 8px; letter-spacing: .16em; font-weight: 800; color: #4a628b; }.auth-copy h1 { font-size: 24px; line-height: 1.12; margin: 7px 0; }.auth-copy p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.55; }
+.google-auth-button,.auth-submit { width: 100%; min-height: 45px; border-radius: 13px; font-weight: 700; cursor: pointer; }
+.google-auth-button { border: 1px solid var(--line); background: #fff; color: var(--ink); display: flex; justify-content: center; gap: 9px; align-items: center; }.google-auth-button span { font-size: 16px; color: #315eb6; }
+.auth-submit { border: 0; background: #344b70; color: #fff; }
+.auth-divider { display: flex; align-items: center; gap: 9px; margin: 15px 0; color: var(--muted); font-size: 9px; }.auth-divider::before,.auth-divider::after { content:""; height: 1px; background: var(--line); flex: 1; }
+.auth-form { display: grid; gap: 10px; }.auth-form label { display: grid; gap: 5px; font-size: 9px; font-weight: 700; }.auth-form input { width: 100%; min-height: 42px; border: 1px solid var(--line); border-radius: 11px; padding: 0 12px; font: inherit; outline: none; }.auth-form input:focus { border-color: #778bab; box-shadow: 0 0 0 3px rgba(74,98,139,.10); }
+.auth-mode-toggle { display: block; margin: 12px auto 0; border: 0; background: transparent; color: #405b84; font-size: 10px; cursor: pointer; }
+.auth-message { min-height: 17px; margin: 12px 0 0; font-size: 9px; text-align: center; color: var(--muted); }.auth-message[data-tone="error"] { color: #a43a3a; }
+.auth-trust { display: block; margin-top: 15px; padding-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font-size: 8px; line-height: 1.5; }
+.account-menu { position: absolute; left: 12px; bottom: 74px; width: calc(100% - 24px); background: #fff; border: 1px solid var(--line); border-radius: 13px; padding: 6px; box-shadow: 0 16px 40px rgba(33,51,78,.12); z-index: 20; }.account-menu[hidden] { display:none; }.account-menu button { width:100%; border:0; background:transparent; text-align:left; padding:9px 10px; border-radius:8px; cursor:pointer; font:inherit; }.account-menu button:hover { background:var(--surface-soft); }
+.left-rail { position: relative; }
+.left-collapsed .account-menu { left: 6px; width: 56px; }.left-collapsed .account-menu button { font-size:0; text-align:center; }.left-collapsed .account-menu button::after { content:"↪"; font-size:16px; }
