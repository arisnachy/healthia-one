--- a/web/styles.css	2026-01-01 00:00:00.000000000 +0000
+++ b/web/styles.css	2026-08-07 02:23:39.489447807 +0000
@@ -727,3 +727,28 @@
 .patient-chip{margin-top:8px}.composer-wrap{position:relative;z-index:2;padding-top:8px;background:linear-gradient(180deg,rgba(248,250,252,0) 0%,rgba(255,255,255,.92) 20%,#fff 42%)}
 .composer{border-radius:24px;border-color:#d9e1eb}.send-button:disabled{opacity:.48;cursor:not-allowed}.panel-toggle{font-size:22px;line-height:1}
 .left-collapsed .left-rail-scroll,.left-collapsed .user-pill>div:last-child{display:none}.left-collapsed .user-pill{width:44px;height:44px;padding:0;justify-content:center;border-radius:14px}.left-collapsed .patient-chip{display:none}
+
+
+/* Judge-visible operational evidence: public actions only, never private reasoning. */
+.execution-heading { margin: 28px 0 12px; max-width: 760px; }
+.execution-heading > span { font-size: 8px; letter-spacing: .18em; font-weight: 800; color: var(--muted); }
+.execution-heading h2 { margin: 5px 0 4px; font-size: 18px; }
+.execution-heading p { margin: 0; color: var(--muted); font-size: 10px; }
+.execution-list { display: grid; gap: 12px; padding-bottom: 36px; }
+.execution-card { border: 1px solid var(--line); border-radius: 18px; background: var(--surface); padding: 15px 16px; box-shadow: 0 10px 30px rgba(34,52,78,.04); }
+.execution-card > header { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
+.execution-card > header span { display: block; color: var(--muted); font-size: 8px; text-transform: uppercase; letter-spacing: .08em; }
+.execution-card h3 { margin: 3px 0 0; font-size: 13px; }
+.execution-card > p { color: var(--slate); font-size: 10px; margin: 10px 0 12px; }
+.execution-badges { display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; }
+.execution-badges > span { border: 1px solid var(--line); background: var(--surface-soft); border-radius: 999px; padding: 4px 7px; text-transform: none !important; letter-spacing: 0 !important; }
+.execution-card[data-runtime="google_adk"] .execution-badges > span:first-child { border-color: #c4d7cb; background: #f1f8f4; }
+.execution-trace { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 7px; }
+.execution-trace li { position: relative; min-height: 60px; border: 1px solid var(--line); border-radius: 12px; padding: 9px; background: var(--surface-soft); }
+.execution-trace li > span { display: block; color: var(--muted); font-size: 7px; text-transform: uppercase; letter-spacing: .08em; }
+.execution-trace li > strong { display: block; margin-top: 4px; font-size: 9px; line-height: 1.25; }
+.execution-trace li > small { display: block; margin-top: 5px; color: var(--muted); font-size: 7px; }
+.execution-trace li[data-stage="closure"] { border-color: #c4d7cb; background: #f1f8f4; }
+.execution-card footer { display: flex; justify-content: space-between; gap: 10px; margin-top: 10px; color: var(--muted); font-size: 8px; }
+@media (max-width: 900px) { .execution-trace { grid-template-columns: 1fr 1fr; } }
+@media (max-width: 560px) { .execution-trace { grid-template-columns: 1fr; } }
