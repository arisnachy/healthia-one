HEALTHIA_ENV=local
HEALTHIA_MODEL=gemini-3.6-flash
HEALTHIA_LLM_BACKEND=mock
HEALTHIA_STORE_BACKEND=json
HEALTHIA_DATA_PATH=.healthia-one/state.json
HEALTHIA_ACCOUNTS_PATH=.healthia-one/accounts.json

# Patient accounts. The secure PowerShell launcher enables these automatically.
HEALTHIA_AUTH_REQUIRED=false
HEALTHIA_ALLOW_REGISTRATION=true
HEALTHIA_SESSION_SECRET=
HEALTHIA_DEVICE_TOKEN_SECRET=

# Demand-driven runtime: no permanent background polling loop.
HEALTHIA_PROACTIVE_ENABLED=false

# Cost guard defaults: no Google AI requests.
HEALTHIA_COST_MODE=local
HEALTHIA_AI_REQUEST_LIMIT=0
HEALTHIA_COST_GUARD_START_ENABLED=false
HEALTHIA_COST_CONTROL_UI=true
HEALTHIA_AI_MAX_OUTPUT_TOKENS=1400

# Configure one Google AI transport for an explicit guarded run. Never commit credentials.
# Gemini Developer API / AI Studio:
GEMINI_API_KEY=
# Vertex AI / Google Cloud ADC (preferred for Cloud deployment):
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
HEALTHIA_GCS_BUCKET=
