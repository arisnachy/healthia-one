HEALTHIA_ENV=local
HEALTHIA_MODEL=gemini-3.6-flash
HEALTHIA_LLM_BACKEND=mock
HEALTHIA_STORE_BACKEND=json
HEALTHIA_DATA_PATH=.healthia-one/state.json
HEALTHIA_PROACTIVE_INTERVAL_SECONDS=20
HEALTHIA_PROACTIVE_ENABLED=true

# Demand-driven agent runtime. Local defaults do not call Google.
HEALTHIA_MISSION_RUNTIME=deterministic
HEALTHIA_AGENTIC_EVENTS_ENABLED=false
HEALTHIA_EVENT_DISPATCH_BACKEND=local
HEALTHIA_PUBSUB_TOPIC=healthia-agentic-events
HEALTHIA_PUBSUB_PUSH_SERVICE_ACCOUNT=
HEALTHIA_CLOUD_REGION=us-central1

# Identity. Cloud judge mode uses Identity Platform/Firebase Auth.
HEALTHIA_AUTH_MODE=local
HEALTHIA_FIREBASE_API_KEY=
HEALTHIA_FIREBASE_AUTH_DOMAIN=
HEALTHIA_FIREBASE_PROJECT_ID=
HEALTHIA_FIREBASE_APP_ID=

# Cost guard defaults: no Google AI requests. In Cloud this is an emergency
# per-instance fuse; Cloud Billing budgets/spend caps are the monetary control.
HEALTHIA_COST_MODE=local
HEALTHIA_AI_REQUEST_LIMIT=0
HEALTHIA_COST_GUARD_START_ENABLED=false
HEALTHIA_COST_CONTROL_UI=true
HEALTHIA_AI_MAX_OUTPUT_TOKENS=700
HEALTHIA_CLOUD_BUDGET_TARGET_USD=45
HEALTHIA_CLOUD_BUDGET_ABSOLUTE_USD=50

# Configure only for an explicit guarded/live run.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
